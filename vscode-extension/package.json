{
  "name": "svn-merge-annotator",
  "displayName": "SVN Merge Annotator",
  "description": "在 VSCode 内展示合并分析结果并进行批注",
  "version": "0.1.29",
  "publisher": "chemclin",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:svnMergeAnnotator.revChanges",
    "onView:svnMergeAnnotator.diffCompare",
    "onCommand:svnMergeAnnotator.runRevRange",
    "onCommand:svnMergeAnnotator.refreshRevChanges",
    "onCommand:svnMergeAnnotator.setRevGroupMode",
    "onCommand:svnMergeAnnotator.setRevChangeFilter",
    "onCommand:svnMergeAnnotator.compareDiffs",
    "onCommand:svnMergeAnnotator.refreshDiffCompare",
    "onCommand:svnMergeAnnotator.openRevDiff",
    "onCommand:svnMergeAnnotator.openRevMergeFile",
    "onCommand:svnMergeAnnotator.applyRevChangeToMerge",
    "onCommand:svnMergeAnnotator.openMergeAtDiffLine",
    "onCommand:svnMergeAnnotator.openMergeByHunkContext",
    "onCommand:svnMergeAnnotator.copyRevHunkDebugLog",
    "onCommand:svnMergeAnnotator.applyRevHunkToMerge",
    "onCommand:svnMergeAnnotator.openMergeBySelection",
    "onCommand:svnMergeAnnotator.setRootPath",
    "onCommand:svnMergeAnnotator.copyRootPath",
    "onCommand:svnMergeAnnotator.clearRootPath",
    "onCommand:svnMergeAnnotator.showRevFileHistory",
    "onCommand:svnMergeAnnotator.compareFileHistory"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "submenus": [
      {
        "id": "svnMergeAnnotator.diffActions",
        "label": "待合并操作"
      },
      {
        "id": "svnMergeAnnotator.contextActions",
        "label": "🔀 合并与对比"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "svnMergeAnnotator",
          "title": "Merge Annotator",
          "icon": "resources/icons/activity.svg"
        }
      ]
    },
    "views": {
      "svnMergeAnnotator": [
        {
          "id": "svnMergeAnnotator.revChanges",
          "name": "提交范围变更"
        },
        {
          "id": "svnMergeAnnotator.diffCompare",
          "name": "差异对比"
        }
      ]
    },
    "commands": [
      {
        "command": "svnMergeAnnotator.runRevRange",
        "title": "提交范围变更",
        "icon": {
          "light": "resources/action-icons/light/run.svg",
          "dark": "resources/action-icons/dark/run.svg"
        },
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.refreshRevChanges",
        "title": "刷新提交范围变更",
        "shortTitle": "刷新范围",
        "icon": {
          "light": "resources/action-icons/light/refresh.svg",
          "dark": "resources/action-icons/dark/refresh.svg"
        },
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.setRevGroupMode",
        "title": "提交范围分组",
        "shortTitle": "分组",
        "icon": {
          "light": "resources/action-icons/light/group.svg",
          "dark": "resources/action-icons/dark/group.svg"
        },
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.setRevChangeFilter",
        "title": "提交范围过滤",
        "shortTitle": "过滤",
        "icon": {
          "light": "resources/action-icons/light/filter.svg",
          "dark": "resources/action-icons/dark/filter.svg"
        },
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.compareDiffs",
        "title": "差异对比",
        "icon": {
          "light": "resources/action-icons/light/compare.svg",
          "dark": "resources/action-icons/dark/compare.svg"
        },
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.refreshDiffCompare",
        "title": "刷新差异对比",
        "shortTitle": "刷新",
        "icon": {
          "light": "resources/action-icons/light/refresh.svg",
          "dark": "resources/action-icons/dark/refresh.svg"
        },
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.openRevDiff",
        "title": "打开提交范围差异",
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.openRevMergeFile",
        "title": "在待合并打开",
        "shortTitle": "定位",
        "icon": {
          "light": "resources/action-icons/light/locate.svg",
          "dark": "resources/action-icons/dark/locate.svg"
        },
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.applyRevChangeToMerge",
        "title": "一键变更到待合并",
        "shortTitle": "整文件合并",
        "icon": {
          "light": "resources/action-icons/light/merge.svg",
          "dark": "resources/action-icons/dark/merge.svg"
        },
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.openMergeAtDiffLine",
        "title": "定位当前行",
        "shortTitle": "当前行",
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.openMergeByHunkContext",
        "title": "定位合并处",
        "shortTitle": "定位",
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.applyRevHunkToMerge",
        "title": "合并此块",
        "shortTitle": "合并",
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.copyRevHunkDebugLog",
        "title": "复制变更块日志",
        "shortTitle": "复制日志",
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.openMergeBySelection",
        "title": "定位选中",
        "shortTitle": "选中",
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.setRootPath",
        "title": "设置路径",
        "shortTitle": "设置",
        "icon": {
          "light": "resources/action-icons/light/folder.svg",
          "dark": "resources/action-icons/dark/folder.svg"
        },
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.copyRootPath",
        "title": "复制路径",
        "shortTitle": "复制",
        "icon": {
          "light": "resources/action-icons/light/copy.svg",
          "dark": "resources/action-icons/dark/copy.svg"
        },
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.clearRootPath",
        "title": "清空路径",
        "shortTitle": "清空",
        "icon": {
          "light": "resources/action-icons/light/trash.svg",
          "dark": "resources/action-icons/dark/trash.svg"
        },
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.showRevFileHistory",
        "title": "查看范围内历史",
        "shortTitle": "历史",
        "icon": {
          "light": "resources/action-icons/light/history.svg",
          "dark": "resources/action-icons/dark/history.svg"
        },
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.compareFileHistory",
        "title": "文件历史双端对比",
        "shortTitle": "双端对比",
        "icon": {
          "light": "resources/action-icons/light/compare.svg",
          "dark": "resources/action-icons/dark/compare.svg"
        },
        "category": "SVN Merge Annotator"
      },
      {
        "command": "svnMergeAnnotator.showLogs",
        "title": "日志",
        "icon": {
          "light": "resources/action-icons/light/logs.svg",
          "dark": "resources/action-icons/dark/logs.svg"
        },
        "category": "SVN Merge Annotator"
      }
    ],
    "configuration": {
      "title": "SVN Merge Annotator",
      "properties": {
        "svnMergeAnnotator.debugLogging": {
          "type": "boolean",
          "default": true,
          "description": "是否输出调试日志到输出面板"
        },
        "svnMergeAnnotator.revGroupMode": {
          "type": "string",
          "default": "dir1",
          "enum": [
            "dir1",
            "dir2",
            "commit"
          ],
          "enumDescriptions": [
            "按一级目录分组",
            "按二级目录分组",
            "按提交记录分组"
          ],
          "description": "提交范围变更分组方式"
        },
        "svnMergeAnnotator.revChangeFilter": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "A",
            "M",
            "D"
          ],
          "enumDescriptions": [
            "全部",
            "仅新增(A)",
            "仅修改(M/R/C)",
            "仅删除(D)"
          ],
          "description": "提交范围变更过滤条件"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "svnMergeAnnotator.runRevRange",
          "when": "view == svnMergeAnnotator.revChanges",
          "group": "navigation"
        },
        {
          "command": "svnMergeAnnotator.refreshRevChanges",
          "when": "view == svnMergeAnnotator.revChanges",
          "group": "navigation"
        },
        {
          "command": "svnMergeAnnotator.setRevGroupMode",
          "when": "view == svnMergeAnnotator.revChanges",
          "group": "navigation"
        },
        {
          "command": "svnMergeAnnotator.setRevChangeFilter",
          "when": "view == svnMergeAnnotator.revChanges",
          "group": "navigation"
        },
        {
          "command": "svnMergeAnnotator.compareDiffs",
          "when": "view == svnMergeAnnotator.diffCompare",
          "group": "navigation"
        },
        {
          "command": "svnMergeAnnotator.refreshDiffCompare",
          "when": "view == svnMergeAnnotator.diffCompare",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "submenu": "svnMergeAnnotator.contextActions",
          "when": "resourceScheme == svnrev",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "svnMergeAnnotator.contextActions",
          "when": "resourceScheme == file",
          "group": "navigation@9"
        }
      ],
      "svnMergeAnnotator.contextActions": [
        {
          "command": "svnMergeAnnotator.openMergeAtDiffLine",
          "when": "resourceScheme == svnrev",
          "group": "navigation@1"
        },
        {
          "command": "svnMergeAnnotator.openMergeBySelection",
          "when": "resourceScheme == svnrev && editorHasSelection",
          "group": "navigation@2"
        },
        {
          "command": "svnMergeAnnotator.compareFileHistory",
          "when": "resourceScheme == file",
          "group": "navigation@3"
        },
        {
          "command": "svnMergeAnnotator.openRevMergeFile",
          "when": "view == svnMergeAnnotator.revChanges && viewItem == revFile",
          "group": "navigation@30"
        },
        {
          "command": "svnMergeAnnotator.applyRevChangeToMerge",
          "when": "view == svnMergeAnnotator.revChanges && viewItem == revFile",
          "group": "navigation@31"
        },
        {
          "command": "svnMergeAnnotator.showRevFileHistory",
          "when": "view == svnMergeAnnotator.revChanges && viewItem == revFile",
          "group": "navigation@32"
        },
        {
          "command": "svnMergeAnnotator.compareFileHistory",
          "when": "view == svnMergeAnnotator.revChanges && viewItem == revFile",
          "group": "navigation@33"
        }
      ],
      "view/item/context": [
        {
          "submenu": "svnMergeAnnotator.contextActions",
          "when": "view == svnMergeAnnotator.revChanges && viewItem == revFile",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.86.0",
    "typescript": "^5.4.5"
  }
}
